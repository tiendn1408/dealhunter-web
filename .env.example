# ==============================================================================
# DealHunter Web — Frontend Environment Configuration Example
# ==============================================================================
# Copy thanh .env.local de chay local. Cach lay tung gia tri: dealhunter/docs/third_party_and_environment_requirements.md
# Bien NEXT_PUBLIC_* duoc nhung vao code luc BUILD: doi gia tri thi phai build lai.

# Backend Go API URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Google OAuth 2.0 Client ID (Phai trung voi GOOGLE_CLIENT_ID tren Backend)
# Lay tu: Google Cloud Console -> APIs & Services -> Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ID cua extension DealHunter Assistant (chrome://extensions). De trong = khong gui phien dang nhap sang extension
NEXT_PUBLIC_EXTENSION_ID=

# Development Server Port
PORT=3000
