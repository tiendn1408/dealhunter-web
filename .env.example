# ==============================================================================
# DealHunter Web — Frontend Environment Configuration Example
# ==============================================================================

# Backend Go API URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Application Settings
NEXT_PUBLIC_APP_NAME=DealHunter
NEXT_PUBLIC_DEFAULT_POLL_INTERVAL=1800
NEXT_PUBLIC_ENABLE_MOCK_SANDBOX=true

# Google OAuth 2.0 Client ID (Phai trung voi GOOGLE_CLIENT_ID tren Backend)
# Lay tu: Google Cloud Console -> APIs & Services -> Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Development Server Port
PORT=3000
